{
  "expo": {
    "name": "AmLoc",
    "slug": "am-loc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amloc",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ro",
        "CFBundleLocalizations": [
          "ro",
          "ro"
        ],
        "NSLocationWhenInUseUsageDescription": "AmLoc folosește locația ta pentru a-ți arăta locurile de parcare libere din apropiere și pentru a raporta mașini care blochează trotuarul.",
        "NSCameraUsageDescription": "AmLoc folosește camera pentru a atașa o fotografie la o sesizare de parcare pe trotuar.",
        "NSPhotoLibraryUsageDescription": "AmLoc accesează pozele pentru a atașa o fotografie la o sesizare."
      },
      "bundleIdentifier": "com.lucadumi.am-loc"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151517",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withForcedLocale",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#151517"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
