# Copy to `.env` and fill in from the Supabase dashboard (Settings -> API).
# `.env` is gitignored; this file is the checked-in record of what is needed.
#
# EXPO_PUBLIC_ is not decoration: Expo only exposes variables with that prefix
# to the app bundle, so anything without it is invisible at runtime.

# Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings -> API -> Project API keys -> `anon` `public`
#
# This one is meant to ship inside the app, and row level security is what
# actually protects the data. Never put the `service_role` key here: it
# bypasses RLS entirely, and with it anyone could forge a reporter's standing,
# which is the single thing the schema exists to prevent.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Leave both blank to run on the bundled car park layers and on-device storage,
# which is what a fresh clone does. The app checks for the pair together: one
# without the other counts as unconfigured rather than half-configured.
#
# The app signs drivers in anonymously so a report can be filed without an
# account, which needs Authentication -> Sign In / Providers -> Anonymous
# sign-ins switched on for the project.

# Settings -> API -> Project API keys -> `service_role`
#
# Only `scripts/import-parking.mjs` reads this, and only when run by hand. The
# imported car parks have no author -- a registry recorded them, no driver added
# them -- and the insert policy for drivers rightly refuses a spot with no
# author, so the bulk import is the one operation that has to go around row
# level security.
#
# NOTE THE MISSING `EXPO_PUBLIC_` PREFIX, which is the whole safety mechanism.
# That prefix is what makes Expo inline a variable into the app bundle; this key
# bypasses row level security entirely, so a copy of it inside the app would
# hand every user the ability to forge anything in the database. Never rename
# it, and never paste this value into any variable that carries the prefix.
SUPABASE_SERVICE_ROLE_KEY=
