# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` itself, not just `.env*.local`: the Supabase URL and anon key live
# there, and while the anon key is meant to be public (row level security is
# what protects the data), a service-role key pasted into the same file would
# not be. Ignoring the whole family removes the chance to find out the hard way.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
